# Copy to .env (or just run ./scripts/setup.sh, which does it for you with
# freshly generated secrets). .env is git-ignored.

# Bearer token Open WebUI must present to the tool server.
TOOL_API_KEY=change-me
# Signs Open WebUI sessions.
WEBUI_SECRET_KEY=change-me

# URL the *browser* uses to fetch generated images.
PUBLIC_BASE_URL=http://localhost:8001

# Model settings (defaults suit a CPU-only machine).
MODEL_ID=stabilityai/sd-turbo
DEFAULT_STEPS=4
GUIDANCE_SCALE=0.0
IDLE_UNLOAD_SECONDS=120
